# Set these in Netlify > Site configuration > Environment variables (or in .env for `npm run dev`).
BOT_TOKEN=your_token_from_BotFather
# Any long random string. Protects the Telegram webhook and the /setup page.
WEBHOOK_SECRET=
# Comma-separated; keys rotate automatically when one is rate-limited
GROQ_API_KEYS=gsk_...,gsk_...
GEMINI_API_KEYS=AIza...,AIza...
# Optional: only if the live-voice links should use a custom domain (default: the site URL)
PUBLIC_URL=
# Optional: set the home group by running /setgroup inside it, or set these:
GROUP_CHAT_ID=
GROUP_LINK=
OWNER_ID=
